diff --git a/src/my282_input.cpp b/src/my282_input.cpp
new file mode 100644
index 0000000..b0d38e7
--- /dev/null
+++ b/src/my282_input.cpp
@@ -0,0 +1,56 @@
+#include "my282_input.h"
+
+#include <cerrno>
+#include <fcntl.h>
+#include <linux/input.h>
+#include <unistd.h>
+
+#include "config_def.h"
+
+namespace {
+
+int inputFd()
+{
+    static int fd = -2;
+    if (fd == -2)
+        fd = open("/dev/input/event3", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    return fd;
+}
+
+SDL_Keycode mapKey(unsigned short code)
+{
+    switch (code) {
+        case 103: return CMDR_KEY_UP;
+        case 108: return CMDR_KEY_DOWN;
+        case 105: return CMDR_KEY_LEFT;
+        case 106: return CMDR_KEY_RIGHT;
+        case 57: return CMDR_KEY_OPEN;
+        case 29: return CMDR_KEY_PARENT;
+        case 42: return CMDR_KEY_OPERATION;
+        case 56: return CMDR_KEY_SYSTEM;
+        case 15: return CMDR_KEY_PAGEUP;
+        case 14: return CMDR_KEY_PAGEDOWN;
+        case 97: return CMDR_KEY_SELECT;
+        case 28: return CMDR_KEY_TRANSFER;
+        case 1: return CMDR_KEY_SYSTEM;
+        default: return SDLK_UNKNOWN;
+    }
+}
+
+} // namespace
+
+bool pollMy282Key(SDL_Keycode *key)
+{
+    const int fd = inputFd();
+    if (fd < 0) return false;
+
+    input_event event{};
+    while (read(fd, &event, sizeof(event)) == sizeof(event)) {
+        if (event.type != EV_KEY || event.value == 0) continue;
+        const SDL_Keycode mapped = mapKey(event.code);
+        if (mapped == SDLK_UNKNOWN) continue;
+        *key = mapped;
+        return true;
+    }
+    return false;
+}
