 namespace {
 
+#ifdef MY282
+constexpr const char *A30_BACKLIGHT_PATH
+    = "/sys/devices/virtual/disp/disp/attr/lcdbl";
+constexpr const char *A30_BACKLIGHT_HANDOFF = "/tmp/nextui-backlight";
+
+void restoreA30Backlight()
+{
+    FILE *handoff = std::fopen(A30_BACKLIGHT_HANDOFF, "r");
+    if (handoff == nullptr) return;
+
+    int raw = 0;
+    const bool valid = std::fscanf(handoff, "%d", &raw) == 1 && raw > 0;
+    std::fclose(handoff);
+    std::remove(A30_BACKLIGHT_HANDOFF);
+    if (!valid) return;
+
+    FILE *backlight = std::fopen(A30_BACKLIGHT_PATH, "w");
+    if (backlight == nullptr) return;
+    std::fprintf(backlight, "%d", raw);
+    std::fclose(backlight);
+}
+
+void unblankA30Framebuffer()
+{
+    const int fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+    if (fd < 0) return;
+    ioctl(fd, FBIOBLANK, FB_BLANK_UNBLANK);
+    close(fd);
+}
+#endif
