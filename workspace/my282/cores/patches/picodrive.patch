+++ forkDstPrefix/pico/cd/libchdr/deps/lzma-24.05/src/CpuArch.c
@@ -847,10 +847,17 @@ BoolInt CPU_IsSupported_NEON(void) { return 1; }
 
 #endif // USE_HWCAP
 
+#ifdef MY_CPU_ARM64
 MY_HWCAP_CHECK_FUNC (CRC32)
 MY_HWCAP_CHECK_FUNC (SHA1)
 MY_HWCAP_CHECK_FUNC (SHA2)
 MY_HWCAP_CHECK_FUNC (AES)
+#else
+BoolInt CPU_IsSupported_CRC32(void) { return 0; }
+BoolInt CPU_IsSupported_SHA1(void)  { return 0; }
+BoolInt CPU_IsSupported_SHA2(void)  { return 0; }
+BoolInt CPU_IsSupported_AES(void)   { return 0; }
+#endif
 
 #endif // __APPLE__
 #endif // _WIN32
